{
  "name": "focusflow",
  "version": "1.0.0",
  "description": "A developer-focused Pomodoro CLI with task management, Git integration, and productivity analytics",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "bin": {
    "focusflow": "./dist/cli.mjs",
    "ff": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.mjs",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pomodoro",
    "timer",
    "cli",
    "productivity",
    "focus",
    "time-tracking",
    "git",
    "developer-tools",
    "terminal"
  ],
  "author": "SOLO Agent",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "conf": "^12.0.0",
    "date-fns": "^3.3.1",
    "figlet": "^1.7.0",
    "inquirer": "^9.2.15",
    "nanospinner": "^1.1.0",
    "node-notifier": "^10.0.1",
    "ora": "^8.0.1",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.11.16",
    "@types/node-notifier": "^8.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gitstq/focusflow.git"
  },
  "bugs": {
    "url": "https://github.com/gitstq/focusflow/issues"
  },
  "homepage": "https://github.com/gitstq/focusflow#readme"
}
